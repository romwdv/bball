{
  "name": "space-bunny",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/make-icons.mjs && next build && node scripts/make-precache-manifest.mjs && node scripts/check-bundle.mjs",
    "start": "node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "serve:https": "node scripts/serve.mjs --https",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:full": "pnpm build && playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "icons": "node scripts/make-icons.mjs",
    "bundle": "node scripts/check-bundle.mjs",
    "bundle:detail": "BUNDLE_REPORT=1 node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@fontsource/abel": "^5.3.0",
    "@fontsource/alexandria": "^5.3.0",
    "@fontsource/encode-sans-expanded": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "dexie": "^4.4.6",
    "next": "16.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "browserslist": [
    "last 2 iOS versions",
    "iOS >= 15.4",
    "last 2 Chrome versions",
    "last 2 Android versions",
    "last 2 Edge versions",
    "last 2 Firefox versions"
  ]
}
