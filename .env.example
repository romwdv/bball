# Variables d'environnement de l'application.
#
# Copier ce fichier vers `.env.local` et compléter les valeurs.
#
# ⚠️ Seule la clé PUBLISHABLE est destinée au client : c'est la conception de
# Supabase, la sécurité repose sur les politiques RLS en base. Ne jamais exposer
# une `service_role` key ici — elle donnerait un accès complet à la base.

# URL du projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé publishable (anon) — trouvée dans Settings → API
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx